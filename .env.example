# Configuração da API do Chatbot
# Escolha uma das opções abaixo:

# Opção 1: OpenAI (ChatGPT)
OPENAI_API_KEY=sua_chave_api_openai_aqui
CHATBOT_MODEL=gpt-4o-mini

# Opção 2: Anthropic (Claude)
# ANTHROPIC_API_KEY=sua_chave_api_anthropic_aqui
# CHATBOT_MODEL=claude-3-5-sonnet-20241022

# Opção 3: Google AI (Gemini)
# GOOGLE_AI_API_KEY=sua_chave_api_google_aqui
# CHATBOT_MODEL=gemini-1.5-flash

# Configuração do provedor (openai, anthropic, ou google)
CHATBOT_PROVIDER=openai
